{
  "hooks": {

    "SessionStart": [
      {
        "type": "command",
        "command": "bash scripts/ml-session-start-hook.sh"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash scripts/ml-tool-capture-hook.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash scripts/ml-session-capture-hook.sh"
      }
    ]

    "SessionStart": ["bash scripts/ml-session-start-hook.sh"],
    "Stop": ["bash scripts/ml-session-capture-hook.sh"]
  }
}
